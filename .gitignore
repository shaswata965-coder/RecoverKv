# Evaluation results and logs (user specific requirement)
# Per-example dumps are ~166MB each and exceed GitHub's 100MB limit; score
# files and summary tables are small and are tracked.
evaluation/results/*.xlsx
evaluation/results/**/*_df.csv
evaluation/logs/*

